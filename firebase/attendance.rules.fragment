    // BEGIN SCHOOL ATTENDANCE v2
    // Profiles remain Console/Admin SDK managed; approved admins manage classes and assignments.
    // attendance_teachers/{uid}: {active:bool,email:string,name:string,role:admin|teacher}.
    // attendance_access/{uid}/classes/{classId}: {active:bool,canRead:bool,
    //   canMorning:bool,canSubject:bool,canBehavior:bool}.
    // attendance_classes/{classId}/students/{studentId}: {code:string,name:string,number:int}.
    // attendance_assignments/{assignmentId}: {teacherUid:string,active:bool,
    //   kind:'morning'|'subject'|'substitute',classId:string,className:string,
    //   subject:string,period:int,weekday:int(0=Sunday),from:timestamp,to:timestamp,
    //   date:timestamp|null,time:string}. from/to/date are Bangkok midnights.
    // Browser-written marks below assignments/{id}/days/{YYYYMMDD}/marks/{studentId}:
    // {assignmentId,teacherUid,classId,studentId:string(1..100),day:timestamp,
    // status:enum,note:string(0..300),revision:int(1..100000),
    // createdAt:timestamp(immutable),updatedAt:timestamp(server time)}.
    // Each mark requires an immutable, identical history/{revision} in the same transaction.
    // attendance_behavior/{eventId}: {teacherUid,classId,studentId:string(1..100),
    // day:timestamp,delta:int(-100..100 except 0),reason:string(1..300),createdAt:timestamp}.
    // Behavior events are append-only. No totals or private teacher profiles are public.
    // Existing budget/procurement rules above this block are intentionally preserved.
    function attSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function attOwner(uid) { return attSignedIn() && request.auth.uid == uid; }
    function attMember() {
      return attSignedIn() && (schoolHasUser() ?
        (schoolUnified() ? schoolUnifiedActive() : schoolActive() && schoolRole('attendanceRole') in ['teacher','admin','viewer']) :
        (get(/databases/$(database)/documents/attendance_teachers/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/attendance_teachers/$(request.auth.uid)).data.email == request.auth.token.email));
    }
    // Roles can only be provisioned in Console/Admin SDK, never by this browser.
    function attAdmin() {
      return attMember() && (schoolHasUser() ? (schoolUnified() ? schoolRole('schoolRole') == 'admin' : schoolRole('attendanceRole') == 'admin') : get(/databases/$(database)/documents/attendance_teachers/$(request.auth.uid)).data.get('role','teacher') == 'admin');
    }
    function attString(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }
    function attId(s) { return attString(s, 1, 100) && s.matches('^[A-Za-z0-9_-]+$'); }
    function attAccess(classId) {
      return get(/databases/$(database)/documents/attendance_access/$(request.auth.uid)/classes/$(classId)).data;
    }
    function attReadClass(classId) {
      return schoolUnifiedActive() || attAdmin() || (attMember() && attAccess(classId).active == true && attAccess(classId).canRead == true);
    }
    function attAssignment(id) {
      return get(/databases/$(database)/documents/attendance_assignments/$(id)).data;
    }
    function attCentralOwnerClass(classId) {
      let p = get(/databases/$(database)/documents/school_users/$(request.auth.uid)).data;
      let unified = p.get('schoolRole','none') != 'none';
      return p.active == true && (unified ?
        p.schoolRole in ['admin','teacher','timetable','budget','procurement','student_support'] :
        p.get('attendanceRole','none') in ['teacher','admin','viewer'] &&
        (p.attendanceRole == 'admin' || (attAccess(classId).active == true && attAccess(classId).canRead == true)));
    }
    function attLegacyOwnerClass(classId) {
      let p = get(/databases/$(database)/documents/attendance_teachers/$(request.auth.uid)).data;
      return p.active == true && p.email == request.auth.token.email &&
        (p.get('role','teacher') == 'admin' || (attAccess(classId).active == true && attAccess(classId).canRead == true));
    }
    function attOwnAssignment(id) {
      let a = attAssignment(id);
      // Resolve the same existing policy once instead of nesting membership checks.
      return attSignedIn() && a.active == true && a.teacherUid == request.auth.uid &&
        (exists(/databases/$(database)/documents/school_users/$(request.auth.uid)) ?
         attCentralOwnerClass(a.classId) : attLegacyOwnerClass(a.classId));
    }
    function attViewAssignment(id) { return schoolUnifiedActive() || attAdmin() || attOwnAssignment(id); }
    function attValidClass(d) {
      return d.keys().hasAll(['name','academicYear','term','active','createdAt','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['name','academicYear','term','active','createdAt','updatedAt','updatedBy']) &&
        attString(d.name,1,80) && d.academicYear is int && d.academicYear >= 2500 && d.academicYear <= 2700 &&
        d.term is int && d.term in [1,2] && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time &&
        d.updatedBy == request.auth.uid;
    }
    function attValidAccess(d) {
      return d.keys().hasAll(['active','canRead','canMorning','canSubject','canBehavior','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['active','canRead','canMorning','canSubject','canBehavior','updatedAt','updatedBy']) &&
        d.active is bool && d.canRead is bool && d.canMorning is bool && d.canSubject is bool && d.canBehavior is bool &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    function attValidDirectory(d, uid) {
      return attId(uid) && d.keys().hasAll(['name','active','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['name','active','updatedAt','updatedBy']) && attString(d.name,1,160) && d.active is bool &&
        d.name == schoolAttendanceProfile(uid).name &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    function attValidAssignment(d) {
      return d.keys().hasAll(['teacherUid','active','kind','classId','className','subject','period','weekday','from','to','date','time','createdAt','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['teacherUid','active','kind','classId','className','subject','period','weekday','from','to','date','time','createdAt','updatedAt','updatedBy']) &&
        attId(d.teacherUid) && schoolAttendanceTarget(d.teacherUid) &&
        d.active is bool && d.kind in ['morning','subject','substitute'] && attId(d.classId) &&
        d.className == get(/databases/$(database)/documents/attendance_classes/$(d.classId)).data.name &&
        attString(d.className,1,80) && attString(d.subject,1,160) && attString(d.time,0,40) &&
        d.period is int && d.period >= 0 && d.period <= 20 && (d.kind != 'morning' || d.period == 0) &&
        d.weekday is int && d.weekday >= 0 && d.weekday <= 6 &&
        d.from is timestamp && d.to is timestamp && attMidnight(d.from) && attMidnight(d.to) && d.from <= d.to &&
        ((d.kind == 'substitute' && d.date is timestamp && attMidnight(d.date) && d.date >= d.from && d.date <= d.to) ||
         (d.kind != 'substitute' && d.date == null)) &&
        d.createdAt is timestamp && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    function attMidnight(day) {
      let local = day + duration.value(7, 'h');
      return day is timestamp && day == timestamp.date(local.year(),local.month(),local.day()) - duration.value(7,'h');
    }
    function attDayKey(day) {
      let local = day + duration.value(7,'h');
      return string(local.year()*10000 + local.month()*100 + local.day());
    }
    // Server-owned blocks prevent stale clients marking a moved lesson.
    function attExchangeAllowed(a, day) {
      let key = a.classId + '_' + attDayKey(day) + '_' + string(a.period);
      let path = /databases/$(database)/documents/attendance_exchange_blocks/$(key);
      return a.kind == 'morning' || (a.get('source','') == 'timetable-exchange' ?
        exists(path) && get(path).data.active == true && get(path).data.exchangeId == a.exchangeId :
        !(exists(path) && get(path).data.active == true));
    }
    function attAssignedDay(a, day) {
      let local = day + duration.value(7,'h');
      return attMidnight(day) && day <= request.time && day >= a.from && day <= a.to && attExchangeAllowed(a, day) &&
        (a.kind == 'morning' ||
         (a.kind == 'subject' && a.weekday == local.dayOfWeek() % 7) ||
         (a.kind == 'substitute' && a.date == day));
    }
    function attCanMark(a, day) {
      return attAssignedDay(a, day) &&
        ((a.kind == 'morning' && attAccess(a.classId).canMorning == true) ||
         (a.kind in ['subject','substitute'] && attAccess(a.classId).canSubject == true));
    }
    function attValidMark(d, aid, dayKey, sid) {
      return d.keys().hasAll(['assignmentId','teacherUid','classId','studentId','day','status','note','revision','createdAt','updatedAt']) &&
        d.keys().hasOnly(['assignmentId','teacherUid','classId','studentId','day','status','note','revision','createdAt','updatedAt']) &&
        attId(d.assignmentId) && d.assignmentId == aid && attId(d.teacherUid) && d.teacherUid == request.auth.uid &&
        attId(d.studentId) && d.studentId == sid && attId(d.classId) && d.classId == attAssignment(aid).classId &&
        d.day is timestamp && dayKey == attDayKey(d.day) &&
        d.status in ['present','late','absent','leave'] && attString(d.note,0,300) &&
        d.revision is int && d.revision >= 1 && d.revision <= 100000 &&
        d.createdAt is timestamp && d.updatedAt is timestamp && d.updatedAt == request.time &&
        exists(/databases/$(database)/documents/attendance_classes/$(d.classId)/students/$(sid)) &&
        attCanMark(attAssignment(aid),d.day);
    }
    function attAuditMatches(aid, dayKey, sid, d) {
      return getAfter(/databases/$(database)/documents/attendance_assignments/$(aid)/days/$(dayKey)/marks/$(sid)/history/$(string(d.revision))).data == d;
    }
    match /attendance_teachers/{uid} {
      allow get: if attOwner(uid) && attMember();
      allow list, create, update, delete: if false;
    }
    match /attendance_access/{uid}/classes/{classId} {
      allow read: if attAdmin() || (attOwner(uid) && attMember());
      allow create, update: if attAdmin() && attId(uid) && attId(classId) && attValidAccess(request.resource.data) &&
        schoolAttendanceTarget(uid) &&
        exists(/databases/$(database)/documents/attendance_classes/$(classId));
      allow delete: if false;
    }
    match /attendance_directory/{uid} {
      // Separate name-only directory; private teacher emails remain owner-only.
      allow read: if attAdmin();
      allow create, update: if attAdmin() && attValidDirectory(request.resource.data,uid);
      allow delete: if false;
    }
    match /attendance_classes/{classId} {
      allow read: if schoolUnifiedActive() || attAdmin();
      allow create: if attAdmin() && attId(classId) && attValidClass(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if attAdmin() && attValidClass(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /attendance_classes/{classId}/students/{sid} {
      allow read: if attReadClass(classId);
      allow write: if false;
    }
    match /attendance_assignments/{aid} {
      // Queries must include teacherUid == current UID and active == true.
      allow read: if schoolUnifiedActive() || attAdmin() || (attMember() && resource.data.teacherUid == request.auth.uid && resource.data.active == true);
      allow create: if attAdmin() && attId(aid) && attValidAssignment(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if attAdmin() && attValidAssignment(request.resource.data) &&
        request.resource.data.teacherUid == resource.data.teacherUid && request.resource.data.classId == resource.data.classId &&
        request.resource.data.kind == resource.data.kind && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /days/{dayKey}/marks/{sid} {
        allow read: if attViewAssignment(aid);
        allow create: if attOwnAssignment(aid) && attValidMark(request.resource.data,aid,dayKey,sid) &&
          request.resource.data.revision == 1 && request.resource.data.createdAt == request.time &&
          attAuditMatches(aid,dayKey,sid,request.resource.data);
        allow update: if attOwnAssignment(aid) && attValidMark(request.resource.data,aid,dayKey,sid) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.day == resource.data.day &&
          request.resource.data.revision == resource.data.revision + 1 &&
          attAuditMatches(aid,dayKey,sid,request.resource.data);
        allow delete: if false;
        match /history/{version} {
          allow read: if attViewAssignment(aid);
          allow create: if attOwnAssignment(aid) && attValidMark(request.resource.data,aid,dayKey,sid) &&
            version == string(request.resource.data.revision) &&
            getAfter(/databases/$(database)/documents/attendance_assignments/$(aid)/days/$(dayKey)/marks/$(sid)).data == request.resource.data;
          allow update, delete: if false;
        }
      }
    }
    match /attendance_behavior/{id} {
      // Teachers read their own entries only; no global score is exposed.
      allow read: if schoolUnifiedActive() || attAdmin() || (attMember() && resource.data.teacherUid == request.auth.uid && attReadClass(resource.data.classId));
      // Score changes require the callable backend; positive scores require approval.
      allow create: if false;
      allow update, delete: if false;
    }
    // END SCHOOL ATTENDANCE v2
